PORT=8080
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_here

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# CORS
# Comma-separated list of allowed origins. 
# In production, if this is not set, cross-origin requests will be BLOCKED.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hrm.duolinkmm.com

# Other integrations
FRONTEND_ONBOARDING_URL=http://localhost:3000
